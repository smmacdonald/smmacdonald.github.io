                                        "__typename": "ParagraphText",
                                        "id": "144",
                                        "verticalAlign": true,
                                        "body": {
                                            "processed": "<p><span class=\"subhead color-accent\">Phase 2 Solution</span></p>\n<p><span class=\"h3\">Headless Platform</span></p>\n<ul>\n<li data-list-item-id=\"e5766f3c786c525ebe31cb9a66ceb8674\">Transitioned to a headless architecture using Drupal 10, Next.js, and GraphQL.</li>\n<li data-list-item-id=\"e49452a14b552ec20d931159af03610e5\">Hosted the application internally on Azure.</li>\n<li data-list-item-id=\"e7b0f6bbbecfd141f29bb6630cc1d2faa\">Built CI/CD pipelines for Development, Test, and Production.</li>\n<li data-list-item-id=\"ecae88c3718e2f94bb28fa3ed96fe8959\">Developed a custom Drupal module to synchronize test data from an internal source.</li>\n<li data-list-item-id=\"ecb74657605c35fa507f36c5a86bdc341\">Enhanced search with Apache Solr for faster, more relevant results</li>\n</ul>\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
