                                        "__typename": "ParagraphText",
                                        "id": "128",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p class=\"text-align-center\"><span class=\"subhead color-accent\">Case Study</span></p>\n<h3 class=\"text-align-center\"><span class=\"h3\">Challenge</span></h3>\n<p class=\"text-align-center\">The legacy Drupal 7 website was not the authoritative source for laboratory test information. Test data existed across multiple systems, creating inconsistencies for client services, sales representatives, and customers. The platform also relied on an aging architecture that limited future development.</p>\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "__typename": "ParagraphSection",
                        "id": "137",
                        "bgColor": "rgba(255, 255, 255, 0.05)",
                        "bgImage": {
                            "__typename": "MediaBackgroundImage",
                            "id": "13",
                            "mediaImage2": {
                                "url": "__ORIGIN__/sites/default/files/2026-07/noisy-texture-200x200-o39-d95-c-4ac1af-t1.png"
                            }
                        },
                        "bgImagePosition": "center center",
                        "bgImageRepeat": "repeat",
                        "bgImageSize": "auto",
                        "centerContent": false,
                        "fullWidth": false,
                        "margin": null,
                        "padding": "padding-top-bottom-60",
                        "sectionId": null,
                        "content": [
                            {
                                "__typename": "ParagraphColumn",
                                "id": "139",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": [
                                    "col-lg-6"
                                ],
                                "styledBox": false,
                                "element": [
                                    {
                                        "__typename": "ParagraphText",
                                        "id": "138",
                                        "verticalAlign": true,
                                        "body": {
                                            "processed": "<p><span class=\"subhead color-accent\">Phase 1 Solution</span></p>\n<p><span class=\"h3\">Drupal 7 -&gt; Drupal 10</span></p>\n<ul>\n<li data-list-item-id=\"e81c58c1b363e7b3b33be411a86e77058\">Migrated the website from Drupal 7 to Drupal 10.</li>\n<li data-list-item-id=\"e4eb874259afb154a0047d0f1c4e473f1\">Created a single source of truth for laboratory test information.</li>\n<li data-list-item-id=\"e38e6505ef30828303e8c4293366e9aa5\">Introduced a downloadable Test Menu PDF generated from the latest data.</li>\n<li data-list-item-id=\"e354499a76d399053a4d1649e09a22da0\">Integrated Salesforce (Pardot) for marketing and lead capture.</li>\n<li data-list-item-id=\"ed3e0a654c8c11a77d128b3379d7e1d61\">Improved confidence that internal teams and customers were accessing current test information.</li>\n</ul>\n"
                                        }
                                    }
                                ]
                            },
