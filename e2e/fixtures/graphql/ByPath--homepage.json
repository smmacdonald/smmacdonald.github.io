                                            "processed": "<div class=\"text-align-center\">\n<p class=\"text-align-center fa-regular fa-code fa-4x color-accent mb-5\"><span style=\"display:none;\">&nbsp;</span></p>\n</div>\n<p class=\"text-align-center\"><span class=\"h3\">Coding Excellence</span></p>\n<p class=\"text-align-center\"><span class=\"subhead color-accent\">clean, scalable, &amp; performant solutions</span></p>\n<ul>\n<li data-list-item-id=\"eda2661d11158cc07541d09427fbac128\">Drupal 7-11 theme &amp; module development</li>\n<li data-list-item-id=\"eddde34de661c76d0938f67ef6bfd7d1e\">Wordpress theme &amp; plugin development</li>\n<li data-list-item-id=\"e2a0d842837d160af6cc17c57a2048e94\">Custom modules &amp; integrations</li>\n<li data-list-item-id=\"e23639c1aa1dba39429e58bfe75c20ca0\">Frontend Build: SCSS, Gulp, NPM, JS</li>\n<li data-list-item-id=\"e951f20230a868a6cd0469392f4d5c26e\">REST API development &amp; integrations</li>\n<li data-list-item-id=\"e5dabfdd0eb5f3e7d8acc1c5edfb37dbb\">Database design &amp; optimization</li>\n</ul>\n"
