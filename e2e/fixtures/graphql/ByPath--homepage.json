                                            "processed": "<div class=\"text-align-center\">\n<p class=\"text-align-center fa-regular fa-user-group fa-4x color-accent mb-5\"><span style=\"display:none;\">&nbsp;</span></p>\n</div>\n<p class=\"text-align-center\"><span class=\"h3\">Leadership</span></p>\n<p class=\"text-align-center\"><span class=\"subhead color-accent\">LEADING TEAMS &amp; EMPOWERING DEVELOPERS</span></p>\n<ul>\n<li data-list-item-id=\"eda2661d11158cc07541d09427fbac128\">Lead developer on multiple projects</li>\n<li data-list-item-id=\"e837482794707919380bc51496ea53f5f\">Mentor &amp; train developers</li>\n<li data-list-item-id=\"e94c5412e3802af97ab1158b7b871ff1d\">Code reviews &amp; best practices</li>\n<li data-list-item-id=\"e84db456b0e7f605ba9a73c596e2a1e8b\">Technical architecture &amp; decisions</li>\n<li data-list-item-id=\"e16b081f1b835951000ca67a82ed936de\">Stakeholder Communication</li>\n<li data-list-item-id=\"e3f56a65c5845ed41d2f39173f00a15bb\">Client training &amp; workshops</li>\n</ul>\n"
                                        }
