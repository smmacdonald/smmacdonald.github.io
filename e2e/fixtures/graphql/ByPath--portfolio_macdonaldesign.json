                        "bgImagePosition": "center center",
                        "bgImageRepeat": "repeat",
                        "bgImageSize": "auto",
                        "centerContent": false,
                        "fullWidth": false,
                        "margin": null,
                        "padding": "padding-top-bottom-60",
                        "sectionId": null,
                        "content": [
                            {
                                "__typename": "ParagraphColumn",
                                "id": "264",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": [
                                    "col-lg-6"
                                ],
                                "styledBox": false,
                                "element": [
                                    {
                                        "__typename": "ParagraphText",
                                        "id": "263",
                                        "verticalAlign": true,
                                        "body": {
                                            "processed": "<p><span class=\"subhead color-accent\">PHASE 1 SOLUTION</span></p>\n<p><span class=\"h3\">Modern Drupal Platform</span></p>\n<ul>\n<li data-list-item-id=\"e14325da0ea3ef791610c9b22f19517b5\">Built a custom Drupal 11 website as the content management platform.</li>\n<li data-list-item-id=\"eeea1ae9a4363f182b0d1f9f0e9042ad7\">Structured portfolio projects, experience, skills, and other content in Drupal.</li>\n<li data-list-item-id=\"eedd96273d33d5b9e5e2748b28f0cd0c0\">Developed a custom content architecture designed to support a headless implementation.</li>\n<li data-list-item-id=\"efc9ae0b3aedfa5c8379bc0ea06893c86\">Used Git and GitHub for source control and version management.</li>\n<li data-list-item-id=\"e10dea5fa713166e353d9583bb56eb854\">Built reusable Drupal components and custom functionality rather than relying entirely on contributed modules.</li>\n</ul>\n"
                                        }
                                    }
                                ]
                            },
