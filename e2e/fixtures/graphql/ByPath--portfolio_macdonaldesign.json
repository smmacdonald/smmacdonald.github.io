                    },
                    {
                        "__typename": "ParagraphSection",
                        "id": "275",
                        "bgColor": null,
                        "bgImage": null,
                        "bgImagePosition": "center center",
                        "bgImageRepeat": "no-repeat",
                        "bgImageSize": "cover",
