                                        "__typename": "ParagraphText",
                                        "id": "260",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p class=\"text-align-center\"><span class=\"subhead color-accent\">CASE STUDY</span></p>\n<p class=\"text-align-center\"><span class=\"h3\">Challenge</span></p>\n<p class=\"text-align-center\">The goal was to build more than a traditional portfolio website. I wanted the site itself to demonstrate modern web development, API-driven architecture, version control, automation, and CI/CD practices while remaining flexible enough to evolve as new projects and technologies were added.</p>\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "__typename": "ParagraphSection",
                        "id": "265",
                        "bgColor": "rgba(255, 255, 255, 0.05)",
                        "bgImage": {
                            "__typename": "MediaBackgroundImage",
                            "id": "13",
                            "mediaImage2": {
                                "url": "__ORIGIN__/sites/default/files/2026-07/noisy-texture-200x200-o39-d95-c-4ac1af-t1.png"
                            }
