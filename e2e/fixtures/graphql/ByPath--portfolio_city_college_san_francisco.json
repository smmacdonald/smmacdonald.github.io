                                        "__typename": "ParagraphText",
                                        "id": "175",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p class=\"text-align-center\"><span class=\"h3\">My Role</span></p>\n<p class=\"text-align-center\">Lead Developer responsible for guiding a team of five developers through the planning, architecture, and implementation of a large-scale university website enhancement project. Served as the primary technical liaison between the agency team and university stakeholders, providing technical direction, code reviews, and solution planning.</p>\n"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
