                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "\u003Cp\u003E\u003Cspan class=\u0022h3\u0022\u003EProblem\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp\u003EThe university needed a more engaging and scalable digital experience that improved access to critical information for students, faculty, and prospective students. Existing systems required more advanced content discovery, better integration with institutional data sources, and a more interactive way to showcase campus resources.\u003C\/p\u003E\n"
                                        }
                                    }
                                ]
                            },
                            {
                                "__typename": "ParagraphColumn",
                                "id": "181",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": ["col-lg-4"],
                                "styledBox": false,
