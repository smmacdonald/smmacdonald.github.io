                        "__typename": "ParagraphSection",
                        "id": "184",
                        "bgColor": "rgba(255, 255, 255, 0.05)",
                        "bgImage": {
                            "__typename": "MediaBackgroundImage",
                            "id": "13",
                            "mediaImage2": {
                                "url": "__ORIGIN__/sites/default/files/2026-07/noisy-texture-200x200-o39-d95-c-4ac1af-t1.png"
                            }
                        },
                        "bgImagePosition": "center center",
                        "bgImageRepeat": "repeat",
                        "bgImageSize": "auto",
                        "centerContent": false,
                        "fullWidth": false,
                        "margin": null,
                        "padding": "padding-top-bottom-60",
                        "sectionId": null,
                        "content": [
                            {
                                "__typename": "ParagraphColumn",
                                "id": "179",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": [
                                    "col-lg-4"
                                ],
                                "styledBox": false,
                                "element": [
                                    {
                                        "__typename": "ParagraphText",
                                        "id": "178",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p><span class=\"h3\">Problem</span></p>\n<p>The university needed a more engaging and scalable digital experience that improved access to critical information for students, faculty, and prospective students. Existing systems required more advanced content discovery, better integration with institutional data sources, and a more interactive way to showcase campus resources.</p>\n"
                                        }
                                    }
                                ]
                            },
                            {
                                "__typename": "ParagraphColumn",
                                "id": "181",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": [
                                    "col-lg-4"
                                ],
                                "styledBox": false,
                                "element": [
                                    {
                                        "__typename": "ParagraphText",
                                        "id": "180",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p><span class=\"h3\">Approach</span></p>\n<ul>\n<li data-list-item-id=\"e347db02c7b145a9a29fb76818812716f\">Led development efforts to create structured content systems for events, news, and academic information.</li>\n<li data-list-item-id=\"ec05051724ea578aca2acf0ba98b33dba\">Integrated the website with the university’s single source of truth through APIs to ensure accurate and synchronized course data.</li>\n<li data-list-item-id=\"e7dff2482a295d05082f9c2b8cbcd4438\">Collaborated with designers and stakeholders to translate user needs into scalable technical solutions.</li>\n<li data-list-item-id=\"e70d07754d5b91d23f790b32301eedbd3\">Guided a team of developers through implementation, code standards, and project delivery.</li>\n</ul>\n"
                                        }
                                    }
                                ]
                            },
                            {
                                "__typename": "ParagraphColumn",
                                "id": "183",
                                "bgColor": null,
                                "sectionId": null,
                                "columnWidth": [
                                    "col-lg-4"
                                ],
                                "styledBox": false,
                                "element": [
                                    {
                                        "__typename": "ParagraphText",
                                        "id": "182",
                                        "verticalAlign": false,
                                        "body": {
                                            "processed": "<p><span class=\"h3\">Key Wins</span></p>\n<ul>\n<li data-list-item-id=\"e419a42c30d7c45bfe4032ac6607513bc\">Developed a robust events calendar and newsroom experience that improved content organization and discovery.</li>\n<li data-list-item-id=\"e89887c5d997bc11779174dc0f54f43b4\">Built an advanced course search platform connected directly to university systems through API integrations.</li>\n<li data-list-item-id=\"eb38c39c9bec3fe157c5415a01d8fd61e\">Created a custom Google Maps experience featuring a 3D campus image overlay for an immersive campus exploration experience.</li>\n<li data-list-item-id=\"e006915ecbe8bcbf73e37b1a2193adcb6\">Established reusable development patterns and technical solutions to support future platform growth.</li>\n</ul>\n"
                                        }
                                    }
                                ]
                            }
                        ]
