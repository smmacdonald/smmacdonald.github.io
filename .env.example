# Copy to .env.local for local development. Do not commit real values.
# Both values are baked into the public JS bundle (NEXT_PUBLIC_*), so they
# must be public URLs and must never contain credentials.

# Origin of the Drupal site (no trailing slash). Locally with DDEV include the router port.
NEXT_PUBLIC_LOCAL_API_URL=https://portfolio.ddev.site

# Drupal GraphQL endpoint.
NEXT_PUBLIC_LOCAL_API_GRAPHQL_URL=https://portfolio.ddev.site/graphql

# Optional. Sub-path the site is served from (e.g. /my-repo). Leave unset when
# deploying to https://<user>.github.io/ or a domain root.
# BASE_PATH=
